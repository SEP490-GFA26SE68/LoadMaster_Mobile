# Nguồn dữ liệu mặc định của mọi feature: mock (kho mẫu trong máy) hoặc http (backend thật).
EXPO_PUBLIC_DATA_SOURCE=mock

# Khi mặc định là mock: danh sách feature đã nối backend, cách nhau bằng dấu phẩy (tên ở src/data/config.ts). Ví dụ: auth,driver
EXPO_PUBLIC_HTTP_FEATURES=

# Địa chỉ backend. Máy ảo Android gọi máy tính bằng 10.0.2.2; điện thoại thật dùng IP trong mạng nội bộ của máy chạy backend.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
